# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://adventure:adventure@localhost:5432/adventure

# ── Auth ─────────────────────────────────────────────────
BETTER_AUTH_SECRET=generate-a-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3001

# ── AWS ──────────────────────────────────────────────────
AWS_REGION=us-east-1

# Choose ONE of the following credential modes:
#
#   (A) Local dev / non-Vercel: set the two keys below.
#       The AWS SDK picks them up via its default credential chain.
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
#
#   (B) Vercel production: set AWS_ROLE_ARN instead. Vercel injects
#       VERCEL_OIDC_TOKEN automatically at runtime when OIDC Federation
#       is enabled in Project Settings → Security. No long-lived keys.
#       See README ("AWS credentials on Vercel") for the full setup.
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/choose-your-own-adventure-prod

# ── Bedrock models ───────────────────────────────────────
BEDROCK_NARRATIVE_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_IMAGE_MODEL_ID=amazon.nova-canvas-v1:0

# ── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
